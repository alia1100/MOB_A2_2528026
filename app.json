{
  "expo": {
    "name": "AUPortfolio",
    "slug": "auportfolio",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "android": {
      "package": "rw.ac.ines.ug2528026.auportfolio",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow AUPortfolio to access your photos to choose a profile picture.",
          "cameraPermission": "Allow AUPortfolio to use the camera to take a profile picture."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "dfa97cf3-0a42-4a3b-a0e8-32d5e0dbeb0f"
      }
    }
  }
}
